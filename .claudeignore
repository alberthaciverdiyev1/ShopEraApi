# .claudeignore
# Claude / AI araçlarının bağlama almaması veya değiştirmemesi gereken yollar.
# Amaç: gereksiz token tüketimini önlemek ve sırları modelden uzak tutmak.

# --- Sırlar ve ortam dosyaları (ASLA okunmamalı) ---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
storage/*.key
storage/firebase/
storage/app/firebase/
*.p8

# --- Bağımlılıklar ve derlenmiş çıktılar ---
/vendor/
node_modules/
/public/build/
/public/hot
/public/storage
/public/dist/
/bootstrap/cache/*.php
dist/
build/

# --- Frontend (resources/frontend — SvelteKit) ---
resources/frontend/.svelte-kit/
resources/frontend/.vite/
resources/frontend/build/
resources/frontend/package-lock.json
# Tema varlıkları: kod bunları yalnızca yolla referans veriyor.
resources/frontend/static/assets/images/
resources/frontend/static/assets/webfonts/
resources/frontend/static/assets/scss/

# --- Şablon kaynakları (resources/html) ---
# .html dosyaları okunabilir kalır; yalnızca büyük asset'ler hariç tutulur.
resources/html/assets/

# --- Medya / yüklenen dosyalar ---
/public/uploads/
/public/assets/uploads/
/storage/app/public/
/storage/app/private/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.svg
*.ico
*.bmp
*.mp4
*.mov
*.avi
*.webm
*.mp3
*.pdf
*.zip
*.rar
*.7z
*.tar
*.gz
*.sql
*.sqlite
*.dump

# --- Web fontları ---
*.woff
*.woff2
*.ttf
*.eot
*.otf

# --- Log ve cache ---
*.log
storage/logs/
/storage/framework/cache/
/storage/framework/sessions/
/storage/framework/views/
/storage/pail/
/.phpunit.cache/
.phpunit.result.cache
bootstrap/cache/
.cache/

# --- Kilit dosyaları (çok büyük, elle düzenlenmez) ---
composer.lock
package-lock.json
yarn.lock
pnpm-lock.yaml

# --- IDE / işletim sistemi ---
/.idea/
/.vscode/
/.fleet/
/.nova/
/.zed/
/.junie/
.DS_Store
Thumbs.db

# --- Üretilmiş / geçici dosyalar ---
*.pid
*.seed
*.tmp
*.bak
*.orig
*.swp
*.swo
*~

# --- Git ---
/.git/
