APP_NAME=Shopera
APP_PORT=3000
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secret
DB_NAME=shopera
DB_SSLMODE=disable

JWT_SECRET=change-me-in-production
JWT_TTL=24h

APP_URL=http://localhost:8000

# Comma-separated allowed CORS origins (empty = allow all).
CORS_ALLOWED_ORIGINS=

# Unicode TTF for receipt PDFs (Cyrillic/Azerbaijani). Empty = auto-detect DejaVu.
PDF_FONT_PATH=

# Deny requests when the required permission is not defined in the database.
# Leave false so undefined (unseeded) permissions are allowed.
PERMISSIONS_STRICT=false

REFRESH_TTL=720h
