{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "foxsoft/snaker",
    "type": "project",
    "description": "Snaker — Laravel e-commerce platform",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "barryvdh/laravel-dompdf": "^3.1",
        "google/apiclient": "^2.18",
        "intervention/image": "^2.7",
        "jenssegers/imagehash": "^0.9.0",
        "laravel-notification-channels/fcm": "^5.1",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.10.1",
        "nwidart/laravel-modules": "^12.0",
        "platformcommunity/flysystem-bunnycdn": "^3.3",
        "pusher/pusher-php-server": "*",
        "sentry/sentry-laravel": "^4.21",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-translatable": "^6.11",
        "stichoza/google-translate-php": "^5.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3"
    },
    "replace": {
        "google/apiclient-services": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Modules\\": "Modules/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/QueryHeplers.php",
            "app/Helpers/TransactionHepler.php",
            "app/Helpers/MailHepler.php",
            "app/Helpers/ResponseHelper.php",
            "app/Helpers/FilterHepler.php",
            "app/Helpers/ReceiptPdfHelper.php",
            "app/Helpers/CompressImageHelper.php",
            "app/Helpers/CompressVideoHelper.php",
            "app/Helpers/ImageHashHelper.php",
            "app/Helpers/AdminHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "storefront:deploy": "@php artisan storefront:deploy",
        "storefront:publish": "@php artisan storefront:deploy --skip-build"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
